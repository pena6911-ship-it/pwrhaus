# Copy to .env for local dev (.env is gitignored). Use TEST/sandbox values only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public anon key: used by the browser dashboard AND build-time event reads (safe to expose).
SUPABASE_ANON_KEY=
# Server-side only (functions/publish.js): Netlify build hook URL that rebuilds the static site.
NETLIFY_BUILD_HOOK=
GHL_API_KEY=
GHL_LOCATION_ID=
RECONCILE_ADMIN_TOKEN=
GHL_PORTAL_URL=
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Merch (Stripe Checkout + Printify drop-ship). PRINTIFY_LIVE stays false until
# real fulfillment is intended — false = create Printify DRAFT orders only, never
# send to production. STRIPE_MERCH_WEBHOOK_SECRET comes from `stripe listen`.
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
PRINTIFY_LIVE=false
STRIPE_MERCH_WEBHOOK_SECRET=whsec_

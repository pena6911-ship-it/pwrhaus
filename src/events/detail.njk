---
layout: base.njk
pagination:
  data: events
  size: 1
  alias: event
permalink: "/events/{{ event.slug }}/"
title: "{{ event.name }} — PWRHaus Golf Society"
description: "{{ event.summary }}"
stickyLabel: Keep me posted
stickyHref: "#join-web_event_interest"
---

{% from "partials/page-hero.njk" import pageHero %}

{{ pageHero({
  eyebrow: event.city,
  heading: event.name,
  lead: event.summary,
  image: event.image,
  position: "50% 45%"
}) }}

<section class="section">
  <div class="container split">
    <div class="stack">
      <p class="eyebrow">{{ event.starts_at | eventDate }}</p>
      <h2>{{ event.venue }}</h2>
      <p>{{ event.body }}</p>
      {% if not event.tickets_enabled %}
      <p>{{ event.price_cents | usd }} · {{ event.capacity }} spots</p>
      {% endif %}
      {% if event.registration_url %}
      <p><a class="btn btn-primary" href="{{ event.registration_url }}">Register</a></p>
      {% endif %}
    </div>
    <img class="media" src="{{ event.image }}" alt="{{ event.image_alt }}" loading="lazy" decoding="async">
  </div>
</section>

{% if event.tickets_enabled %}
<section class="section" id="tickets">
  <div class="container stack">
    <div class="section-heading">
      <p class="eyebrow">Tickets</p>
      <h2>Claim your spot</h2>
    </div>
    <div class="ticket-summary">
      <p class="ticket-summary-name">{{ event.name }}</p>
      <p class="ticket-summary-meta">{{ event.starts_at | eventDate }}</p>
      <p class="ticket-summary-meta">{{ event.venue }}{% if event.city %} &middot; {{ event.city }}{% endif %}</p>
      <p class="ticket-summary-meta" id="ticket-availability" data-capacity="{{ event.capacity }}">{{ event.capacity }} spots for this event</p>
    </div>
    <form id="ticket-form" class="stack" data-slug="{{ event.slug }}">
      <p class="ticket-prices">
        {% if event.member_price_cents %}
        PWRHAUS Member <strong>{{ event.member_price_cents | usd }}</strong> &middot; Non-Member <strong>{{ (event.nonmember_price_cents or event.price_cents) | usd }}</strong>
        {% else %}
        {# No member rate set, so everyone pays one price. Labelling it
           "Non-Member" would imply a member rate exists and read as a penalty. #}
        <strong>{{ (event.nonmember_price_cents or event.price_cents) | usd }}</strong> per ticket
        {% endif %}
      </p>
      <div class="field">
        <label for="tf-name-{{ event.slug }}">Your name</label>
        <input id="tf-name-{{ event.slug }}" name="full_name" type="text" autocomplete="name" required>
      </div>
      <div class="field">
        <label for="tf-email-{{ event.slug }}">Your email</label>
        <input id="tf-email-{{ event.slug }}" name="email" type="email" autocomplete="email" required>
      </div>
      <div class="field">
        <label for="tf-quantity-{{ event.slug }}">Tickets</label>
        <select id="tf-quantity-{{ event.slug }}" name="quantity">
          <option>1</option><option>2</option><option>3</option><option>4</option>
        </select>
      </div>
      {% if event.member_price_cents %}<p class="ticket-note">Member pricing is applied automatically if your email is on our member list.</p>{% endif %}
      <p class="ticket-note">Buying more than one? You can add your guests&rsquo; names afterwards &mdash; you don&rsquo;t need them now. Guest names can be added or changed up to <strong>3 hours after the event starts</strong>. After that all tickets for the event expire: they cannot be named, transferred to another event, or refunded.</p>
      <button class="btn btn-primary" type="submit">Continue to payment</button>
      <p class="form-msg" role="status"></p>
    </form>
  </div>
</section>
<script src="/js/tickets.js" defer></script>
{% endif %}

<section class="section band">
  <div class="container">
    {% set formSource = "web_event_interest" %}
    {% set formHeading = "Ask about this event" %}
    {% set formSubmitLabel = "Keep me posted" %}
    {% set showNotes = true %}
    {% include "partials/capture-form.njk" %}
  </div>
</section>
